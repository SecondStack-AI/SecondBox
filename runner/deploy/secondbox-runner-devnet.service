[Unit]
# Persistent host bridge for Firecracker microVM dev networking.
# The microVM bridge gateway owns the address the in-VM HTTP_PROXY and the
# host-side egress credential proxy both target, so it must exist before `just
# dev` / `just dev-api` start. Without this unit the bridge is created lazily by
# the server on first VM launch and vanishes on reboot, which breaks the dev
# loop until a VM happens to launch again.
#
# Placeholders are substituted from .env (SECONDBOX_RUNNER_SANDBOX_BRIDGE_NAME /
# SECONDBOX_RUNNER_SANDBOX_BRIDGE_CIDR) by `just net-install`.
Description=SecondBox Runner development microVM bridge (@BRIDGE_NAME@)
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Idempotent: leading '-' ignores "File exists" when the bridge or address is
# already present (e.g. a manual restart without a reboot).
ExecStart=-/usr/bin/ip link add name @BRIDGE_NAME@ type bridge
ExecStart=-/usr/bin/ip addr add @BRIDGE_CIDR@ dev @BRIDGE_NAME@
ExecStart=/usr/bin/ip link set @BRIDGE_NAME@ up
ExecStop=-/usr/bin/ip link set @BRIDGE_NAME@ down
ExecStop=-/usr/bin/ip link delete @BRIDGE_NAME@

[Install]
WantedBy=multi-user.target
