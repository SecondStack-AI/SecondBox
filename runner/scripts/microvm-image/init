#!/bin/sh
set -eu

mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts
mountpoint -q /dev/pts || mount -t devpts -o nosuid,noexec,mode=0620,ptmxmode=0666 devpts /dev/pts
rm -f /dev/ptmx
ln -s pts/ptmx /dev/ptmx
# The tool guest never needs raw memory, KVM, or TUN device access. devtmpfs
# creates some of these nodes from the guest kernel's built-in device set even
# though Firecracker did not pass the corresponding host devices through.
# Remove them before accepting any vsock tool request so the guest boundary is
# explicit and remains testable from inside the VM.
rm -f /dev/mem /dev/kmem /dev/port /dev/kvm /dev/net/tun
mkdir -p /dev/shm
mountpoint -q /dev/shm || mount -t tmpfs -o rw,nosuid,nodev,mode=1777,size=512m tmpfs /dev/shm

template_mode="$(sed -n 's/.*secondbox\.template_mode=\([01]\).*/\1/p' /proc/cmdline)"

# The kernel's ip= autoconfiguration records its explicit nameserver only in
# /proc/net/pnp. libc does not read that file, so materialize the runner DNS
# proxy before any networked cold-booted Sandbox command can resolve a domain.
# An intentionally offline runner attaches no eth0 and therefore has no DNS
# identity to require. A resumed template receives the same resolver during its
# one assignment bind instead.
if [ "$template_mode" != "1" ] && [ -e /sys/class/net/eth0 ]; then
    nameserver="$(sed -n 's/^nameserver \([^ ]*\)$/\1/p' /proc/net/pnp | head -n 1)"
    if [ -z "$nameserver" ]; then
        echo "SecondBox guest cold boot lacks the runner DNS identity" >&2
        exit 1
    fi
    printf 'nameserver %s\noptions attempts:1 timeout:2\n' "$nameserver" > /etc/resolv.conf
fi

mkdir -p /workspace /runtime-private
# runtime-private holds vsock-delivered secrets; keep it RAM-only so credentials
# never land on the persistent workspace image or any snapshot.
mountpoint -q /runtime-private || mount -t tmpfs -o rw,nosuid,nodev,mode=0700 tmpfs /runtime-private
# A snapshot-resume template must not mount its Workspace before capture: the
# captured superblock and page cache belong to the template's sterile image, and
# every resumed Instance stages a different one onto the same device. The guest
# agent mounts it inside the one assignment bind instead.
if [ "$template_mode" != "1" ] && ! mountpoint -q /workspace; then
    workspace_mode=rw
    if [ "$(cat /sys/block/vdb/ro)" = "1" ]; then
        workspace_mode=ro
    fi
    mount -t ext4 -o "$workspace_mode",noatime /dev/vdb /workspace
fi

if [ -b /dev/vdc ]; then
    mkdir -p /shared
    mount -o ro /dev/vdc /shared
fi

exec /usr/local/bin/secondbox-runner-guest-entrypoint \
    --agents=/workspace/config/agents.md \
    --soul=/workspace/config/soul.md \
    --tools=/workspace/config/tools.md \
    /workspace
