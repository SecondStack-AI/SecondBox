#!/bin/sh
set -eu

version='@VERSION@'
expected_sha256='@BINARY_SHA256@'
download_url="https://github.com/SecondStack-AI/SecondBox/releases/download/v${version}/secondbox-deploy_${version}_linux_amd64"

if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
  printf '%s\n' 'SecondBox guided install currently supports Linux on amd64 only.' >&2
  exit 1
fi

temporary_directory=$(mktemp -d "${TMPDIR:-/tmp}/secondbox-install.XXXXXX")
binary="$temporary_directory/secondbox-deploy"
cleanup() {
  rm -rf -- "$temporary_directory"
}
child_pid=
terminate() {
  signal="$1"
  status="$2"
  trap - EXIT HUP INT TERM
  if [ -n "$child_pid" ]; then
    kill -s "$signal" "$child_pid" 2>/dev/null || :
    wait "$child_pid" 2>/dev/null || :
  fi
  cleanup
  exit "$status"
}
trap cleanup EXIT
trap 'terminate HUP 129' HUP
trap 'terminate INT 130' INT
trap 'terminate TERM 143' TERM

if command -v curl >/dev/null 2>&1; then
  curl --fail --location --proto '=https' --tlsv1.2 --output "$binary" "$download_url"
elif command -v wget >/dev/null 2>&1; then
  wget --https-only --output-document="$binary" "$download_url"
else
  printf '%s\n' 'SecondBox install requires curl or wget.' >&2
  exit 1
fi

if command -v sha256sum >/dev/null 2>&1; then
  actual_sha256=$(sha256sum "$binary" | awk '{print $1}')
elif command -v shasum >/dev/null 2>&1; then
  actual_sha256=$(shasum -a 256 "$binary" | awk '{print $1}')
else
  printf '%s\n' 'SecondBox install requires sha256sum or shasum.' >&2
  exit 1
fi

if [ "$actual_sha256" != "$expected_sha256" ]; then
  printf '%s\n' "SecondBox installer checksum mismatch: expected $expected_sha256, received $actual_sha256." >&2
  exit 1
fi

chmod 0755 "$binary"
# Keep the verified executable at a stable pathname while the installer runs. It
# re-executes itself through the privilege boundary for narrow host apply, and
# os.Executable must therefore continue to resolve to a path root can open.
command=install
if [ "$#" -gt 0 ] && [ "$1" = update ]; then
  command=update
  shift
fi
if [ "$command" = install ] && [ "$#" -eq 0 ]; then
  if [ ! -r /dev/tty ]; then
    printf '%s\n' 'SecondBox guided install requires an interactive terminal. Use secondbox-deploy install --check for unattended preflight.' >&2
    exit 1
  fi
  "$binary" install </dev/tty &
elif [ "$command" = update ] && { [ "$#" -eq 0 ] || { [ "$1" != --check ] && [ "$1" != --resume ]; }; }; then
  if [ ! -r /dev/tty ]; then
    printf '%s\n' 'SecondBox guided update requires an interactive terminal. Use update --check for unattended validation.' >&2
    exit 1
  fi
  "$binary" update "$@" </dev/tty &
else
  "$binary" "$command" "$@" &
fi
child_pid=$!
if wait "$child_pid"; then
  status=0
else
  status=$?
fi
child_pid=
exit "$status"
