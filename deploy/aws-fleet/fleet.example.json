{
  "pool": "code-elastic",
  "controlPlaneUrl": "https://secondbox.internal:8090",
  "platformTokenFile": "/etc/secondbox-fleet/platform-token",
  "databaseUrlFile": "/etc/secondbox-fleet/database-url",
  "controlPlaneCaFile": "/etc/secondbox-fleet/control-plane-ca.crt",
  "region": "us-east-1",
  "groupName": "secondstack-elastic-code-test",
  "qualificationRun": "replace-with-run-id",
  "minimumNodes": 0,
  "maximumNodes": 2,
  "nodeVcpuCount": 4,
  "nodeMemoryBytes": 12884901888,
  "nodeInstances": 2,
  "nodeWorkspaceBytes": 68719476736,
  "scaleInAfterSeconds": 600,
  "bootstrapTimeoutSeconds": 1800,
  "maximumArchivesPerPass": 1,
  "pollSeconds": 10,
  "enrollment": {
    "listenAddress": ":9444",
    "serverCertificateFile": "/etc/secondbox-fleet/server.crt",
    "serverPrivateKeyFile": "/etc/secondbox-fleet/server.key",
    "runnerCaFile": "/etc/secondbox-fleet/runner-ca.crt",
    "runnerCaKeyFile": "/etc/secondbox-fleet/runner-ca.key",
    "runnerEnvironmentFile": "/etc/secondbox-fleet/runner.env",
    "gatewayEnvironmentFile": "/etc/secondbox-fleet/gateway.env",
    "egressContextsFile": "/etc/secondbox-fleet/egress-contexts.json",
    "registryDirectory": "/etc/secondbox-fleet/image-registry",
    "lifetimeSeconds": 86400,
    "windowSeconds": 1800,
    "accountId": "replace-with-account-id",
    "workerRoleName": "secondstack-elastic-code-test-worker",
    "gatewayIssuerUrl": "https://gateway-issuer.internal:9443",
    "gatewayControlCertificateFile": "/etc/secondbox-fleet/control.crt",
    "gatewayControlKeyFile": "/etc/secondbox-fleet/control.key",
    "gatewayCaFile": "/etc/secondbox-fleet/gateway-issuer-ca.crt"
  }
}
