# Copy to ~/.config/secondbox/release.env. This is a Bash environment file.
# Public paths below describe the reviewed release host; edit for another host.
# The bundle and trust anchor are the v0.12.0 rotation (docs/releases/v0.12.0.md).
# The Go suite gate needs a disposable PostgreSQL database. Leave
# SECONDBOX_TEST_DATABASE_URL unset and the run provisions its own container
# on a random loopback port from QUALIFY_TEST_POSTGRES_IMAGE (digest-pinned;
# defaults to the reviewed release Postgres image) and removes it afterwards.
# Set the URL only to reuse a database you manage yourself.
# SECONDBOX_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# QUALIFY_TEST_POSTGRES_IMAGE=docker.io/library/postgres@sha256:...

# Require real qualification; scenarios must never skip absent prerequisites.
SECONDBOX_REQUIRE_QUALIFIED_SCENARIO=1
# Signed, immutable microVM artifact directory.
SECONDBOX_SCENARIO_MICROVM_ARTIFACTS_DIR=/home/sasha/Developer/.secondbox-releases/bundles/secondbox-0.12.0
# Public signing key and SHA-256 of its DER encoding (not a secret).
SECONDBOX_RUNNER_ARTIFACT_PUBLIC_KEY=/home/sasha/.config/secondbox/trust/manifest-public.pem
SECONDBOX_RUNNER_ARTIFACT_PUBLIC_KEY_SHA256=59c127f459b8c93ca422f2f6c5bd43ff1e17d50309a262b7aff1b07bf59a5ced
# Registry transport of the same signed bundle, used by selected-image scenarios.
SECONDBOX_SCENARIO_EXECUTION_IMAGE='ghcr.io/secondstack-ai/secondbox/microvm-artifacts@sha256:13143d07ded13a098531e415de294ae32c52868e0f9c338f1be472935431df17'
SECONDBOX_SCENARIO_IMAGE_REGISTRY_CONFIG=/home/sasha/.config/secondbox/qualification-image-registry
# Existing runner-local reflink-capable workspace root for disposable scenarios.
SECONDBOX_RUNNER_WORKSPACE_ROOT=/home/sasha/Developer/.secondbox-release-scenario-workspaces
# Exact signed runtime and toolchain manifest digests.
SECONDBOX_SCENARIO_RUNTIME_BUNDLE_DIGEST=sha256:2ca676c7b22f7b81df57f4fcb2061e1538bd4393bb99e4f08300baecbb9e30b7
SECONDBOX_SCENARIO_TOOLCHAIN_BUNDLE_DIGEST=sha256:656dd7b7c2ea8e26d388f1d9ff1492da3abe11b915cc029009e42a252fc31bd1
# PR Firecracker and release Firecracker/gVisor host shard count; default 4.
# PR Firecracker permits 1..64; local gVisor permits at most 7 reserved pairs.
QUALIFY_FIRECRACKER_SHARDS=4

# Dedicated local gVisor build cache, created automatically when absent.
# Docker Buildx prepares pinned assets and the guest agent from this checkout.
# Existing manually assembled roots are not adopted; select a new path instead.
# See docs/operations/gvisor-runtime.md for ownership and cache retention.
QUALIFY_GVISOR_HOST_BUILD_ROOT=/home/sasha/Developer/.secondbox-gvisor/release-build

# Nightly-only QEMU directory containing disk.qcow2, seed.img, id_ed25519, known_hosts.
# Automation leaves this VM running. Do not share it with another qualification.
QUALIFY_GVISOR_VM_DIR=/home/sasha/Developer/.secondbox-gvisor/vm
# Loopback SSH forwarding port, range 1..65535; user has passwordless sudo.
QUALIFY_GVISOR_SSH_PORT=2262
QUALIFY_GVISOR_SSH_USER=debian
# Dedicated existing clone in the VM; automation checks out the shipped HEAD.
QUALIFY_GVISOR_REPO=/home/debian/SecondBox
# Existing pinned runsc, rootfs/, and destination for the rebuilt guest agent.
QUALIFY_GVISOR_BUILD_ROOT=/opt/gvisor-qual/build
# Existing reflink image and mountpoint inside the VM.
QUALIFY_GVISOR_REFLINK_IMAGE=/opt/gvisor-qual/reflink.img
QUALIFY_GVISOR_REFLINK_MOUNT=/var/lib/secondbox-reflink

# Usage: just qualify [--tier pr|release|nightly] [--only gates|firecracker|gvisor]
# Reattach: just qualify --wait RUN (RUN is printed at launch).
# Logs and a timing table live in .tmp/qualify/RUN; environment snapshots are
# private (0700 directory, 0600 files). Provision dependencies with npm ci
# --ignore-scripts before qualifying. Only selected stages' inputs are required.
# The ten gates: verify-generated, test, test-contract, test-compose,
# test-image-policy, test-sdk-packages, test-deployment, test-install-docs,
# test-release-workflow, lint. Packaging waits for generated SDK output; all
# other gates and selected scenario stages start concurrently.

# Release uses this entire file for qualify as well (QUALIFY_ENV_FILE).
# Reviewed toolchain, independent of caller PATH and mise shims.
RELEASE_GOROOT=/home/sasha/.local/share/mise/installs/go/1.25.12
RELEASE_PROTOC_BIN=/tmp/task3-protoc/bin
# Artifact-build-only builder (does not change qualification Docker builds); create it as documented in release-operator-setup.md.
RELEASE_BUILDX_BUILDER=secondbox-suite-release
# Public signed release inputs; the private signing key is never needed.
SECONDBOX_RUNNER_MICROVM_RELEASE_SOURCE_DIR=/home/sasha/Developer/.secondbox-releases/bundles/secondbox-0.12.0
SECONDBOX_RUNNER_MICROVM_RELEASE_PUBLIC_KEY=/home/sasha/.config/secondbox/trust/manifest-public.pem
SECONDBOX_RUNNER_MICROVM_RELEASE_PUBLIC_KEY_SHA256=59c127f459b8c93ca422f2f6c5bd43ff1e17d50309a262b7aff1b07bf59a5ced
SECONDBOX_RELEASE_POSTGRES_IMAGE=docker.io/library/postgres@sha256:882236b897e39051d2368c5ccc6cda944904723506b2dfc97f2a8f5bc9afa382
# Existing output parent; VERSION-build, VERSION-candidate, VERSION must be absent.
RELEASE_OUTPUT_ROOT=/home/sasha/Developer/tries/secondbox-fq-release/releases
# Existing dedicated Btrfs parent traversable by system libvirt.
SECONDBOX_INSTALLER_EXISTING_WORKSPACE_ROOT=/home/sasha/Developer/tries/secondbox-fq-release/installer-workspaces
SECONDBOX_INSTALLER_QUALIFICATION_IMAGE=/home/sasha/Developer/tries/secondbox-attribution-qualification/ubuntu-24.04-20260725-amd64.img
SECONDBOX_INSTALLER_QUALIFICATION_IMAGE_SHA256=d1940f7d69d343355e183dff1e08a59852d32e7309baa7a4bad8365b11b005ac
# Per guest memory (13312..1048576 MiB), defaults to 16384. Use 13312 on smaller hosts.
# Release stages run sequentially and require a guest plus 4096 MiB available.
# At most three guests;
# parallelism is capped by MemAvailable after a 4096 MiB host reserve.
QUALIFY_GUEST_MEMORY_MIB=16384

# just release defaults to linux/amd64 images and the btrfs_image installer guest.
# --full selects linux/amd64,linux/arm64 and all installer modes (nightly suites).
# release-stage.sh accepts RELEASE_IMAGE_PLATFORMS for direct manual staging.
# All four host CLI/deploy binary platforms are always built.
# RELEASE_ENV_FILE selects an alternate explicit release configuration.
