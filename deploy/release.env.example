# Copy to ~/.config/secondbox/release.env. This is a Bash environment file.
# Public paths below describe the reviewed release host; edit for another host.
# Tests must use an explicitly supplied disposable PostgreSQL database URL.
# Export SECONDBOX_TEST_DATABASE_URL in your shell or set it here.
# SECONDBOX_TEST_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# Require real qualification; scenarios must never skip absent prerequisites.
SECONDBOX_REQUIRE_QUALIFIED_SCENARIO=1
# Signed, immutable microVM artifact directory.
SECONDBOX_SCENARIO_MICROVM_ARTIFACTS_DIR=/home/sasha/Developer/.secondbox-v030-test/runner-artifacts
# Public signing key and SHA-256 of its DER encoding (not a secret).
SECONDBOX_RUNNER_ARTIFACT_PUBLIC_KEY=/home/sasha/Developer/.secondbox-v030-test/runner-artifacts/signing.pub
SECONDBOX_RUNNER_ARTIFACT_PUBLIC_KEY_SHA256=40a61101ea2574faf4f6715eb7201cfece7c48b51495cc319896b4e87c63931b
# Existing runner-local reflink-capable workspace root for disposable scenarios.
SECONDBOX_RUNNER_WORKSPACE_ROOT=/home/sasha/Developer/.secondbox-release-scenario-workspaces
# Exact signed runtime and toolchain manifest digests.
SECONDBOX_SCENARIO_RUNTIME_BUNDLE_DIGEST=sha256:9279ca3f8bc3eac4adcd1953926a33fc42da99641d60af042eea12eb12ba0335
SECONDBOX_SCENARIO_TOOLCHAIN_BUNDLE_DIGEST=sha256:cd859a7b0ef9849cc842c8b9c4d0b3b21340e50bed1ac712126585a9fa5553b4
# PR-only number of independent scenario stacks; defaults to 4, range 1..64.
QUALIFY_FIRECRACKER_SHARDS=4

# QEMU directory containing disk.qcow2, seed.img, id_ed25519, known_hosts.
# Automation leaves this VM running. Do not share it with another qualification.
QUALIFY_GVISOR_VM_DIR=/home/sasha/Developer/.secondbox-gvisor/vm
# Loopback SSH forwarding port, range 1..65535; user has passwordless sudo.
QUALIFY_GVISOR_SSH_PORT=2262
QUALIFY_GVISOR_SSH_USER=debian
# Dedicated existing clone in the VM; automation checks out the shipped HEAD.
QUALIFY_GVISOR_REPO=/home/debian/SecondBox
# Existing pinned runsc, rootfs/, and destination for the rebuilt guest agent.
QUALIFY_GVISOR_BUILD_ROOT=/opt/gvisor-qual/build
# Existing reflink image and mountpoint inside the VM.
QUALIFY_GVISOR_REFLINK_IMAGE=/opt/gvisor-qual/reflink.img
QUALIFY_GVISOR_REFLINK_MOUNT=/var/lib/secondbox-reflink

# Usage: just qualify [--tier pr|release] [--only gates|firecracker|gvisor]
# Reattach: just qualify --wait RUN (RUN is printed at launch).
# Logs and a timing table live in .tmp/qualify/RUN; environment snapshots are
# private (0700 directory, 0600 files). Provision dependencies with npm ci
# --ignore-scripts before qualifying. Only selected stages' inputs are required.
# The ten gates: verify-generated, test, test-contract, test-compose,
# test-image-policy, test-sdk-packages, test-deployment, test-install-docs,
# test-release-workflow, lint. Packaging waits for generated SDK output; all
# other gates and selected scenario stages start concurrently.

# Release uses this entire file for qualify as well (QUALIFY_ENV_FILE).
# Reviewed toolchain, independent of caller PATH and mise shims.
RELEASE_GOROOT=/home/sasha/.local/share/mise/installs/go/1.25.12
RELEASE_PROTOC_BIN=/tmp/task3-protoc/bin
# Public signed release inputs; the private signing key is never needed.
SECONDBOX_RUNNER_MICROVM_RELEASE_SOURCE_DIR=/home/sasha/Developer/github.com/SecondStack-AI/secondstack-docker-data/llmops_secondbox_runner_artifacts
SECONDBOX_RUNNER_MICROVM_RELEASE_PUBLIC_KEY=/home/sasha/Developer/.secondbox-release-trust/manifest-public.pem
SECONDBOX_RUNNER_MICROVM_RELEASE_PUBLIC_KEY_SHA256=40a61101ea2574faf4f6715eb7201cfece7c48b51495cc319896b4e87c63931b
SECONDBOX_RELEASE_POSTGRES_IMAGE=docker.io/library/postgres@sha256:882236b897e39051d2368c5ccc6cda944904723506b2dfc97f2a8f5bc9afa382
# Existing output parent; VERSION-build, VERSION-candidate, VERSION must be absent.
RELEASE_OUTPUT_ROOT=/home/sasha/Developer/tries/secondbox-fq-release/releases
# Existing dedicated Btrfs parent traversable by system libvirt.
SECONDBOX_INSTALLER_EXISTING_WORKSPACE_ROOT=/home/sasha/Developer/tries/secondbox-fq-release/installer-workspaces
SECONDBOX_INSTALLER_QUALIFICATION_IMAGE=/home/sasha/Developer/tries/secondbox-attribution-qualification/ubuntu-24.04-20260725-amd64.img
SECONDBOX_INSTALLER_QUALIFICATION_IMAGE_SHA256=d1940f7d69d343355e183dff1e08a59852d32e7309baa7a4bad8365b11b005ac
# Per guest memory (8192..1048576 MiB), defaults to 16384. At most three guests;
# parallelism is capped by MemAvailable after an 8192 MiB host reserve.
QUALIFY_GUEST_MEMORY_MIB=16384
