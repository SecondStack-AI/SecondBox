# Copy to ~/.config/secondbox/release.env on the Linux arm64 release host. This is a Bash environment file.
# `just release-arm64` reads it for scenario qualification and arm64 staging.
# The checkout, SECONDBOX_RUNNER_WORKSPACE_ROOT and the scenario bundle must share one reflink filesystem.

# Require real qualification; scenarios must never skip absent prerequisites.
SECONDBOX_REQUIRE_QUALIFIED_SCENARIO=1
# Signed arm64 microVM bundle the scenarios run, normally the release bundle below.
SECONDBOX_SCENARIO_MICROVM_ARTIFACTS_DIR=/srv/secondbox-release/bundles/secondbox-arm64
# Public signing key and SHA-256 of its DER encoding (not a secret); the same anchor as the amd64 release.
SECONDBOX_RUNNER_ARTIFACT_PUBLIC_KEY=/srv/secondbox-release/trust/manifest-public.pem
SECONDBOX_RUNNER_ARTIFACT_PUBLIC_KEY_SHA256=59c127f459b8c93ca422f2f6c5bd43ff1e17d50309a262b7aff1b07bf59a5ced
# Signed arm64 selected-image fixture in a registry the scenario image fetcher trusts.
SECONDBOX_SCENARIO_EXECUTION_IMAGE='registry.example.internal/secondstack-ai/secondbox/microvm-artifacts@sha256:...'
SECONDBOX_SCENARIO_IMAGE_REGISTRY_CONFIG=/srv/secondbox-release/qualification-image-registry
SECONDBOX_SCENARIO_IMAGE_FETCHER_DNS=1.1.1.1
SECONDBOX_RUNNER_WORKSPACE_ROOT=/srv/secondbox-release/scenario-workspaces

# Reviewed toolchain, independent of caller PATH and mise shims.
RELEASE_GOROOT=/opt/go1.25.12
# Artifact-build-only builder; create it as documented in release-operator-setup.md.
RELEASE_BUILDX_BUILDER=secondbox-suite-release
# Public signed arm64 release inputs; the private signing key is never needed.
SECONDBOX_RUNNER_MICROVM_RELEASE_SOURCE_DIR=/srv/secondbox-release/bundles/secondbox-arm64
SECONDBOX_RUNNER_MICROVM_RELEASE_PUBLIC_KEY=/srv/secondbox-release/trust/manifest-public.pem
SECONDBOX_RUNNER_MICROVM_RELEASE_PUBLIC_KEY_SHA256=59c127f459b8c93ca422f2f6c5bd43ff1e17d50309a262b7aff1b07bf59a5ced
# Existing output parent; VERSION-arm64 must be absent.
RELEASE_OUTPUT_ROOT=/srv/secondbox-release/releases
