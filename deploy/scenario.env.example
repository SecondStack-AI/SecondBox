# Qualified Firecracker release host: public paths and artifact identities.
# Load with: set -a; source deploy/scenario.env.example; set +a
# Require real host qualification; the suite never skips prerequisites.
SECONDBOX_REQUIRE_QUALIFIED_SCENARIO=1
# microVM release assets.
SECONDBOX_SCENARIO_MICROVM_ARTIFACTS_DIR=/home/sasha/Developer/.secondbox-v030-test/runner-artifacts
# Existing reflink filesystem; each suite creates its own workspace beneath it.
SECONDBOX_RUNNER_WORKSPACE_ROOT=/home/sasha/Developer/.secondbox-release-scenario-workspaces
# Optional: one-based deterministic shard (e.g. 1/2); no qualification evidence.
# SECONDBOX_SCENARIO_SHARD=1/2
