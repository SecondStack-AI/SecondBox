{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondbox.dev/schemas/release-supply-chain-evidence-v1.json",
  "title": "SecondBox per-subject supply-chain evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "releaseVersion",
    "sourceCommit",
    "status",
    "summary",
    "subjects"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "evidenceType": {
      "enum": [
        "sbom",
        "vulnerability",
        "dependency-age",
        "license",
        "checksums",
        "signature",
        "provenance"
      ]
    },
    "releaseVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "enum": ["passed", "blocked", "failed"]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/subjectEvidence"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "subjectEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectId",
        "subjectSHA256",
        "status",
        "summary",
        "artifacts"
      ],
      "properties": {
        "subjectId": {
          "type": "string",
          "minLength": 1
        },
        "subjectSHA256": {
          "$ref": "#/$defs/sha256"
        },
        "status": {
          "enum": ["passed", "blocked", "failed"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifact"
          }
        }
      }
    }
  }
}
