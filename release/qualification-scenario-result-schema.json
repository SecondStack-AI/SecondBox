{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondbox.dev/schemas/release-qualification-scenario-result-v1.json",
  "title": "SecondBox packaged release qualification scenario result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gate",
    "scenarioId",
    "releaseVersion",
    "sourceCommit",
    "subjectManifestSHA256",
    "status",
    "summary",
    "hostIds",
    "subjectIds",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "gate": {
      "enum": [
        "kvm",
        "durability",
        "data-plane",
        "network",
        "security"
      ]
    },
    "scenarioId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "releaseVersion": {
      "type": "string",
      "minLength": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "subjectManifestSHA256": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "passed"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "hostIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "subjectIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
