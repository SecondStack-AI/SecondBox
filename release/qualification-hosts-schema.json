{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondbox.dev/schemas/release-qualification-hosts-v1.json",
  "title": "SecondBox release qualification host inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "hosts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/host"
      }
    }
  },
  "$defs": {
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "deploymentMode",
        "operatingSystem",
        "architecture",
        "dedicated",
        "kvm"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "role": {
          "enum": [
            "controller",
            "control-plane",
            "runner"
          ]
        },
        "deploymentMode": {
          "enum": [
            "external",
            "systemd",
            "compose"
          ]
        },
        "operatingSystem": {
          "enum": [
            "linux"
          ]
        },
        "architecture": {
          "enum": [
            "amd64"
          ]
        },
        "dedicated": {
          "type": "boolean"
        },
        "kvm": {
          "type": "boolean"
        }
      }
    }
  }
}
