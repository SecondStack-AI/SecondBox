build-flue-store:
    cd flue-store && npm run build

# Build signed Firecracker kernel/rootfs/shared-image artifacts for agent runtimes.
build-microvm-images:
    scripts/microvm-image/build.sh

# Build signed images from a reproducible standard rootfs source
# (scripts/microvm-image/rootfs/). Prepares the source dir via debootstrap+docker,
# then builds and signs, reusing the current kernel. Needs debootstrap, docker,
# root/sudo, and network egress.
build-microvm-images-std:
    #!/usr/bin/env bash
    set -euo pipefail
    scripts/microvm-image/rootfs/build-rootfs-source.sh
    AG_MICROVM_ROOTFS_SOURCE_DIR="${AG_MICROVM_ROOTFS_SOURCE_DIR:-tmp/microvm-rootfs-src}" \
    AG_MICROVM_KERNEL_PATH="${AG_MICROVM_KERNEL_PATH:-releases/microvm/latest/kernel}" \
    AG_MICROVM_ROOTFS_SIZE_MIB="${AG_MICROVM_ROOTFS_SIZE_MIB:-10240}" \
    scripts/microvm-image/build.sh

# Build the deployable agent runtime artifacts.
build-runtime: build-microvm-images

# Build only the pinned Firecracker guest kernel from scripts/microvm-image/kernel.lock.
build-microvm-kernel:
    scripts/microvm-image/build-kernel.sh "${AG_MICROVM_KERNEL_OUT_DIR:-tmp/microvm-kernel}"

# Verify signed Firecracker artifacts. Override AG_MICROVM_OUT_DIR to select a build.
verify-microvm-images:
    scripts/microvm-image/verify.sh "${AG_MICROVM_OUT_DIR:-releases/microvm/latest}" "${AG_MICROVM_PUBLIC_KEY:-}"

# Validate Firecracker staging host prerequisites. Pass --static via ARGS for
# non-root config/artifact checks only.
verify-microvm-staging *ARGS:
    scripts/microvm-stage-check.sh {{ARGS}}

# Benchmark Firecracker stop-to-snapshot and snapshot wake latency. Pass --cold
# before an optional agent id/name to also measure a cold force-restart baseline.
benchmark-microvm-snapshot-start *ARGS:
    scripts/benchmark-microvm-snapshot-start.sh {{ARGS}}

# Expects AG_MICROVM_*_PATH to point at releases/microvm/latest/* or another stable path.
# Rebuild Firecracker runtime artifacts and restart running agents.
rollout-microvm-images api_url="http://localhost:8081":
    #!/usr/bin/env bash
    set -euo pipefail

    just build-microvm-images

    TOKEN="${AGENTCY_API_TOKEN:-${AG_API_AUTH_TOKEN:-}}"
    HEADERS=(-H "Content-Type: application/json")
    if [ -n "$TOKEN" ]; then
        HEADERS+=(-H "X-Agentcy-Token: $TOKEN")
    fi

    curl -fsS -X POST "{{api_url}}/api/admin/restart-running-agents" "${HEADERS[@]}"

# Use `just build-runtime` when a prepared AG_MICROVM_ROOTFS_SOURCE_DIR is available for signed Firecracker images.
