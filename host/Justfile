# Run the authoritative Go test gate, including Postgres-backed DB contracts.
test:
    #!/usr/bin/env bash
    set -euo pipefail
    export AGENT_MANAGER_TEST_DATABASE_URL="${AGENT_MANAGER_TEST_DATABASE_URL:-${FLUE_STORE_CONTRACT_DATABASE_URL:-postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable}}"
    export AGENT_MANAGER_DATABASE_URL="${AGENT_MANAGER_DATABASE_URL:-$AGENT_MANAGER_TEST_DATABASE_URL}"
    scripts/test/go-fast.sh
    scripts/test/go-db.sh

# Compile every Go test package, then run packages whose test dependency graph
# does not include the shared Postgres fixture. The full `just test` gate remains
# authoritative for database contracts.
test-fast *ARGS:
    scripts/test/go-fast.sh {{ARGS}}

# Run Channel Runtime operation, authority, semantic, and mapping contract fixtures.
test-channel-runtime-contract:
