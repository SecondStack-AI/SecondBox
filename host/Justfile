preship:
    #!/usr/bin/env bash
    set -euo pipefail
    scripts/test/backend-checks.sh
    just test
    (cd flue-store && npm test && npm run test:contract && npm run build)
    (cd agent && npm run typecheck && npm run lint && npm test && npm run build)

