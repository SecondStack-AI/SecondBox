tidy:
    go mod tidy

install-deps:
    cd agent && npm install
    cd flue-store && npm install

install-dev-tools:
    go install github.com/air-verse/air@latest

setup: install-deps tidy install-dev-tools
    @echo "Setup complete"

clean:
