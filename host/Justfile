# Sandbox Host build and validation tasks.

default:
    @just --list

build:
    mkdir -p bin
    go build -o bin/sandbox-host ./cmd/sandbox-host
    go build -o bin/sandbox-guest-agent ./cmd/sandbox-guest-agent

build-microvm-images:
    scripts/microvm-image/build.sh

build-microvm-images-std:
    #!/usr/bin/env bash
    set -euo pipefail
    scripts/microvm-image/rootfs/build-rootfs-source.sh
    SANDBOX_HOST_MICROVM_ROOTFS_SOURCE_DIR=tmp/microvm-rootfs-src \
    SANDBOX_HOST_MICROVM_KERNEL_PATH=releases/microvm/latest/kernel \
    SANDBOX_HOST_MICROVM_ROOTFS_SIZE_MIB=10240 \
    scripts/microvm-image/build.sh

build-microvm-kernel:
    scripts/microvm-image/build-kernel.sh tmp/microvm-kernel

verify-microvm-images artifact_dir="releases/microvm/latest":
    scripts/microvm-image/verify.sh {{ artifact_dir }} {{ artifact_dir }}/signing.pub

verify-microvm-staging *ARGS:
    scripts/microvm-stage-check.sh {{ ARGS }}

# Install the persistent Firecracker development bridge.
net-install:
    #!/usr/bin/env bash
    set -euo pipefail
    : "${SANDBOX_HOST_MICROVM_BRIDGE_NAME:?SANDBOX_HOST_MICROVM_BRIDGE_NAME is required}"
    : "${SANDBOX_HOST_MICROVM_BRIDGE_CIDR:?SANDBOX_HOST_MICROVM_BRIDGE_CIDR is required}"
    UNIT_DST="/etc/systemd/system/sandbox-host-devnet.service"
    sed -e "s|@BRIDGE_NAME@|${SANDBOX_HOST_MICROVM_BRIDGE_NAME}|g" \
        -e "s|@BRIDGE_CIDR@|${SANDBOX_HOST_MICROVM_BRIDGE_CIDR}|g" \
        deploy/sandbox-host-devnet.service | sudo tee "$UNIT_DST" >/dev/null
    sudo systemctl daemon-reload
    sudo systemctl enable --now sandbox-host-devnet.service
    ip addr show to "${SANDBOX_HOST_MICROVM_BRIDGE_CIDR%%/*}/32" | grep -q .

# Grant the current user the narrow ip/iptables privileges used by the devnet shims.
net-sudoers:
    #!/usr/bin/env bash
    set -euo pipefail
    USER_NAME="$(id -un)"
    IP_BIN="$(command -v ip)"
    IPTABLES_BIN="$(command -v iptables)"
    DROPIN="/etc/sudoers.d/sandbox-host-devnet"
    TMP="$(mktemp)"
    trap 'rm -f "$TMP"' EXIT
    printf '%s\n' \
        "# Installed by Sandbox Host for Firecracker development networking." \
        "${USER_NAME} ALL=(root) NOPASSWD: ${IP_BIN}, ${IPTABLES_BIN}" > "$TMP"
    sudo visudo -cf "$TMP"
    sudo install -m 0440 -o root -g root "$TMP" "$DROPIN"

# Remove the persistent Firecracker development bridge.
net-uninstall:
    #!/usr/bin/env bash
    set -euo pipefail
    sudo systemctl disable --now sandbox-host-devnet.service
    sudo rm -f /etc/systemd/system/sandbox-host-devnet.service
    sudo systemctl daemon-reload

test:
    scripts/ci_paths_test.sh
    scripts/microvm-image/browser-surface-policy-test.sh
    scripts/microvm-image/trust-anchor-policy-test.sh
    go test ./... -count=1
    go vet ./...

preship: test build
