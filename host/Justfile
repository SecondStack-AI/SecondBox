# Agentcy — build and development tasks

set dotenv-load

# Default recipe - show help
default:
    @just --list

# =============================================================================
# Development
# =============================================================================

# Start backend + frontend with hot-reload
dev:
    @just _dev-impl

# Build the local speech worker image when speech is enabled and the image is missing.
_ensure-speech-worker:
    #!/usr/bin/env bash
    set -euo pipefail

    if [[ "${AG_SPEECH_ENABLED:-false}" != "true" ]]; then
        exit 0
    fi

    image="${AG_SPEECH_WORKER_IMAGE:-agentcy/speech-worker:latest}"
    if docker image inspect "$image" >/dev/null 2>&1; then
        exit 0
    fi

    echo "Speech is enabled and Docker image $image is missing."
    echo "Building local speech worker image..."
    docker build -t "$image" ./speech-worker

# Internal dev implementation
_dev-impl:
    #!/usr/bin/env bash
    set -e

    PROJECT_ROOT="${JUST_INVOCATION_DIRECTORY:-.}"
    cd "$PROJECT_ROOT"

    just _ensure-speech-worker

    echo "Starting Agentcy development environment..."
    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "  API:      http://localhost:8081"
    echo "  Frontend: http://localhost:5173 (proxies /api → :8081)"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo ""

    AIR_BIN="$(command -v air || true)"
    if [[ -z "$AIR_BIN" ]]; then
        GOBIN_DIR="$(go env GOBIN 2>/dev/null || true)"
        if [[ -n "$GOBIN_DIR" && -x "$GOBIN_DIR/air" ]]; then
            AIR_BIN="$GOBIN_DIR/air"
        fi
    fi
    if [[ -z "$AIR_BIN" ]]; then
        GOPATH_DIR="$(go env GOPATH 2>/dev/null || true)"
        if [[ -n "$GOPATH_DIR" && -x "$GOPATH_DIR/bin/air" ]]; then
            AIR_BIN="$GOPATH_DIR/bin/air"
        fi
    fi
    if [[ -z "$AIR_BIN" ]]; then
        echo "air is required for hot reload but was not found."
        echo "Install it with: go install github.com/air-verse/air@latest"
        exit 1
    fi

    trap "kill 0" EXIT
    "$AIR_BIN" &
    (cd frontend && npm run dev) &
    wait

# Start only the Go backend with hot-reload
dev-api:
    @just _dev-api-impl

_dev-api-impl:
    #!/usr/bin/env bash
    set -e

    PROJECT_ROOT="${JUST_INVOCATION_DIRECTORY:-.}"
    cd "$PROJECT_ROOT"

    just _ensure-speech-worker

    AIR_BIN="$(command -v air || true)"
    if [[ -z "$AIR_BIN" ]]; then
        GOBIN_DIR="$(go env GOBIN 2>/dev/null || true)"
        if [[ -n "$GOBIN_DIR" && -x "$GOBIN_DIR/air" ]]; then
            AIR_BIN="$GOBIN_DIR/air"
        fi
    fi
    if [[ -z "$AIR_BIN" ]]; then
        GOPATH_DIR="$(go env GOPATH 2>/dev/null || true)"
        if [[ -n "$GOPATH_DIR" && -x "$GOPATH_DIR/bin/air" ]]; then
            AIR_BIN="$GOPATH_DIR/bin/air"
        fi
    fi
    if [[ -z "$AIR_BIN" ]]; then
        echo "air is required for hot reload but was not found."
        echo "Install it with: go install github.com/air-verse/air@latest"
        exit 1
    fi

    "$AIR_BIN"

# Start only the frontend dev server (with API proxy to :8081)
dev-frontend:
    cd frontend && npm run dev

# =============================================================================
# Build
# =============================================================================

# Build the Go backend
build:
    go build -o bin/agentcy ./cmd/agentcy

# Build the frontend
build-frontend:
    cd frontend && npm run build

# Build the agent Node.js code
build-agent:
    cd agent && npm run build

# Build the agent Docker image
build-agent-image:
    cd agent && docker build -f Dockerfile.agent -t agentcy/agent:latest .

# Build the speech worker Docker image
build-speech-worker:
    #!/usr/bin/env bash
    set -euo pipefail

    image="${AG_SPEECH_WORKER_IMAGE:-agentcy/speech-worker:latest}"
    docker build -t "$image" ./speech-worker

# Rebuild the agent image and restart all currently running agents so they pick up the new image.
rollout-agent-image api_url="http://localhost:8081":
    #!/usr/bin/env bash
    set -euo pipefail

    just build-agent-image

    TOKEN="${AGENTCY_API_TOKEN:-${AG_API_AUTH_TOKEN:-}}"
    HEADERS=(-H "Content-Type: application/json")
    if [ -n "$TOKEN" ]; then
        HEADERS+=(-H "X-Agentcy-Token: $TOKEN")
    fi

    curl -fsS -X POST "${api_url}/api/admin/restart-running-agents" "${HEADERS[@]}"

# Build everything
all: build build-agent build-agent-image build-speech-worker build-frontend
    @echo "All builds complete"

# =============================================================================
# Testing
# =============================================================================

# Run Go tests
test:
    go test ./...

# =============================================================================
# Utilities
# =============================================================================

# Tidy Go modules
tidy:
    go mod tidy

# Install all npm dependencies
install-deps:
    cd agent && npm install
    cd frontend && npm install

# Install Go-based local development tools
install-dev-tools:
    go install github.com/air-verse/air@latest

# Full development setup
setup: install-deps tidy install-dev-tools
    @echo "Setup complete"

# Clean build artifacts
clean:
    rm -rf bin/
    cd agent && npm run clean
    rm -rf cmd/agentcy/public/

# =============================================================================
# Deployment (agentcy.t1a.dev)
# =============================================================================

AG_HOST := "agentcy.t1a.dev"
AG_BOOTSTRAP_USER := "root"
AG_USER := "agentdeploy"
AG_PATH := "/opt/agentcy"
AG_RUNTIME_USER := "agentcy"

# Initial server setup (run once before first ship)
setup-server:
    #!/usr/bin/env bash
    set -euo pipefail

    echo "Setting up Agentcy server at {{AG_HOST}}"
    echo "=============================================="

    ssh -o ConnectTimeout=10 {{AG_BOOTSTRAP_USER}}@{{AG_HOST}} '
        set -euo pipefail

        # Install Docker
        if ! command -v docker &>/dev/null; then
            echo "Installing Docker..."
            apt-get update
            apt-get install -y ca-certificates curl
            install -m 0755 -d /etc/apt/keyrings
            curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
            chmod a+r /etc/apt/keyrings/docker.asc
            echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo "$VERSION_CODENAME") stable" > /etc/apt/sources.list.d/docker.list
            apt-get update
            apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin
            systemctl enable docker
            systemctl start docker
            echo "Docker installed"
        else
            echo "Docker already installed"
        fi

        # Install Caddy
        if ! command -v caddy &>/dev/null; then
            echo "Installing Caddy..."
            apt-get install -y debian-keyring debian-archive-keyring apt-transport-https
            curl -1sLf "https://dl.cloudsmith.io/public/caddy/stable/gpg.key" | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
            curl -1sLf "https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt" | tee /etc/apt/sources.list.d/caddy-stable.list
            apt-get update
            apt-get install -y caddy
            echo "Caddy installed"
        else
            echo "Caddy already installed"
        fi

        # Create directory structure
        echo "Creating directories..."
        mkdir -p {{AG_PATH}}/{bin,data,public}

        # Create dedicated deploy user
        if ! id -u {{AG_USER}} >/dev/null 2>&1; then
            echo "Creating deploy user {{AG_USER}}..."
            useradd --create-home --shell /bin/bash {{AG_USER}}
        else
            echo "Deploy user {{AG_USER}} already exists"
        fi

        # Create dedicated runtime user
        if ! id -u {{AG_RUNTIME_USER}} >/dev/null 2>&1; then
            echo "Creating runtime user {{AG_RUNTIME_USER}}..."
            useradd --system --home-dir {{AG_PATH}} --shell /usr/sbin/nologin {{AG_RUNTIME_USER}}
        else
            echo "Runtime user {{AG_RUNTIME_USER}} already exists"
        fi

        if getent group docker >/dev/null 2>&1; then
            usermod -aG docker {{AG_RUNTIME_USER}}
            usermod -aG docker {{AG_USER}}
        fi

        install -d -m 0700 -o {{AG_USER}} -g {{AG_USER}} /home/{{AG_USER}}/.ssh
        if [ -f /root/.ssh/authorized_keys ]; then
            install -m 0600 -o {{AG_USER}} -g {{AG_USER}} /root/.ssh/authorized_keys /home/{{AG_USER}}/.ssh/authorized_keys
        fi

        printf '%s\n' '{{AG_USER}} ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/{{AG_USER}}
        chmod 0440 /etc/sudoers.d/{{AG_USER}}

        chown root:root {{AG_PATH}}
        chmod 0755 {{AG_PATH}}
        chown -R {{AG_RUNTIME_USER}}:{{AG_RUNTIME_USER}} {{AG_PATH}}/data
        chmod 0750 {{AG_PATH}}/data
        chmod 0755 {{AG_PATH}}/bin {{AG_PATH}}/public

        echo ""
        echo "Server setup complete!"
    '

    # Generate .env if it does not exist
    if ssh -o ConnectTimeout=10 {{AG_BOOTSTRAP_USER}}@{{AG_HOST}} "test -f {{AG_PATH}}/.env"; then
        echo ".env already exists on server"
    else
        echo "Creating .env from template..."
        ENCRYPTION_KEY=$(openssl rand -base64 32)
        sed "s|^AG_SECRET_ENCRYPTION_KEY=.*|AG_SECRET_ENCRYPTION_KEY=${ENCRYPTION_KEY}|" \
            deploy/agentcy.env.example | \
            ssh -o ConnectTimeout=10 {{AG_BOOTSTRAP_USER}}@{{AG_HOST}} "cat > {{AG_PATH}}/.env && chown root:{{AG_RUNTIME_USER}} {{AG_PATH}}/.env && chmod 0640 {{AG_PATH}}/.env"
        echo ".env created (admin credentials NOT set — edit before first start)"
        echo "  ssh {{AG_USER}}@{{AG_HOST}} 'sudo -n vi {{AG_PATH}}/.env'"
    fi

# Ship to production (build + deploy)
ship:
    #!/usr/bin/env bash
    set -euo pipefail

    VERSION=$(git rev-parse --short HEAD)
    TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    IMAGE_TAG="${VERSION}-${TIMESTAMP}"
    REMOTE_TMP="/home/{{AG_USER}}/.agentcy-deploy-${IMAGE_TAG}"

    echo "Shipping Agentcy to {{AG_HOST}}"
    echo "  Version: ${IMAGE_TAG}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Pre-flight checks (local only — no SSH yet)
    echo ""
    echo "Pre-flight checks..."
    [ -f "deploy/Caddyfile" ] || { echo "deploy/Caddyfile not found"; exit 1; }
    [ -f "deploy/agentcy.service" ] || { echo "deploy/agentcy.service not found"; exit 1; }
    command -v docker >/dev/null || { echo "Docker not installed locally"; exit 1; }
    echo "Pre-flight checks passed"

    # Step 1: Build frontend
    echo ""
    echo "Building frontend..."
    cd frontend && npm run build && cd ..

    # Step 2: Cross-compile Go binary for linux/amd64
    echo ""
    echo "Building Go binary (linux/amd64)..."
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o bin/agentcy-linux-amd64 ./cmd/agentcy

    # Step 3: Build agent Docker image
    echo ""
    echo "Building agent Docker image..."
    just build-agent-image

    # Step 4: Save agent image to tarball
    echo ""
    echo "Saving agent Docker image..."
    mkdir -p releases
    docker save agentcy/agent:latest | gzip > releases/agentcy-agent.tar.gz
    echo "  Size: $(du -h releases/agentcy-agent.tar.gz | cut -f1)"

    # Open SSH control socket (one TCP connection for all remote operations)
    SSH_SOCK="/tmp/agentcy-deploy-$$"
    SSH_OPTS=(-o ControlMaster=auto -o "ControlPath=${SSH_SOCK}" -o ControlPersist=300 -o ConnectTimeout=30 -o ServerAliveInterval=15)
    trap 'ssh "${SSH_OPTS[@]}" -O exit {{AG_USER}}@{{AG_HOST}} 2>/dev/null || true; rm -f "${SSH_SOCK}"' EXIT

    echo ""
    echo "Connecting to {{AG_HOST}}..."
    CONNECTED=false
    for attempt in 1 2 3; do
        if ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "echo ok" >/dev/null 2>&1; then
            CONNECTED=true
            break
        fi
        echo "  Connection attempt $attempt/3 failed, retrying..."
        sleep 2
    done
    if [ "$CONNECTED" != "true" ]; then
        echo "Cannot reach {{AG_HOST}} via SSH. Check server status."
        exit 1
    fi
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "sudo -n true" >/dev/null 2>&1 || { echo "Deploy user {{AG_USER}} is missing passwordless sudo"; exit 1; }
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "sudo -n test -f {{AG_PATH}}/.env" || { echo "Server .env not found. Run: just setup-server"; exit 1; }

    # Step 5: Stop service before uploading (can't overwrite a running binary)
    echo "Stopping agentcy service..."
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "sudo -n systemctl stop agentcy 2>/dev/null || true"

    # Step 6: Upload to server (all over the same TCP connection)
    echo ""
    echo "Uploading to {{AG_HOST}}..."
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "rm -rf ${REMOTE_TMP} && mkdir -p ${REMOTE_TMP}"
    scp "${SSH_OPTS[@]}" bin/agentcy-linux-amd64 {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/agentcy
    scp "${SSH_OPTS[@]}" -r cmd/agentcy/public {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/public
    scp "${SSH_OPTS[@]}" releases/agentcy-agent.tar.gz {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/agentcy-agent.tar.gz
    scp "${SSH_OPTS[@]}" deploy/Caddyfile {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/Caddyfile
    scp "${SSH_OPTS[@]}" deploy/agentcy.service {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/agentcy.service

    # Step 7: Load agent image and restart services
    echo ""
    echo "Loading agent image and restarting services..."
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "
        set -euo pipefail

        if ! id -u {{AG_RUNTIME_USER}} >/dev/null 2>&1; then
            sudo -n useradd --system --home-dir {{AG_PATH}} --shell /usr/sbin/nologin {{AG_RUNTIME_USER}}
        fi
        if getent group docker >/dev/null 2>&1; then
            sudo -n usermod -aG docker {{AG_RUNTIME_USER}}
        fi

        sudo -n install -d -m 0755 {{AG_PATH}}/bin
        sudo -n install -m 0755 ${REMOTE_TMP}/agentcy {{AG_PATH}}/bin/agentcy

        sudo -n rm -rf {{AG_PATH}}/public
        sudo -n mkdir -p {{AG_PATH}}/public
        sudo -n cp -a ${REMOTE_TMP}/public/. {{AG_PATH}}/public/
        sudo -n chmod 0755 {{AG_PATH}}/public

        sudo -n install -m 0644 ${REMOTE_TMP}/Caddyfile /etc/caddy/Caddyfile
        sudo -n install -m 0644 ${REMOTE_TMP}/agentcy.service /etc/systemd/system/agentcy.service

        sudo -n chown -R {{AG_RUNTIME_USER}}:{{AG_RUNTIME_USER}} {{AG_PATH}}/data
        sudo -n chmod 0750 {{AG_PATH}}/data
        sudo -n chown root:{{AG_RUNTIME_USER}} {{AG_PATH}}/.env
        sudo -n chmod 0640 {{AG_PATH}}/.env

        echo 'Loading Docker image...'
        sudo -n docker load < ${REMOTE_TMP}/agentcy-agent.tar.gz
        rm -rf ${REMOTE_TMP}

        sudo -n systemctl daemon-reload
        sudo -n systemctl enable agentcy
        sudo -n systemctl restart agentcy

        sudo -n systemctl reload caddy || sudo -n systemctl restart caddy

        echo ''
        echo 'Service status:'
        sudo -n systemctl status agentcy --no-pager -l || true
    "

    # Step 8: Health check
    echo ""
    echo "Verifying service health..."
    sleep 3

    HEALTH_OK=false
    for i in {1..20}; do
        if ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "curl -sf http://localhost:8081/api/health >/dev/null 2>&1"; then
            HEALTH_OK=true
            break
        fi
        echo "  Waiting for services... ($i/20)"
        sleep 2
    done

    if [ "$HEALTH_OK" = "true" ]; then
        echo "Health check passed"
    else
        echo "Health check timed out — check logs: just logs-prod"
    fi

    # Record deployed version
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "printf '%s\n' '${IMAGE_TAG}' | sudo -n tee {{AG_PATH}}/.deployed_version >/dev/null"

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Deployment complete!"
    echo "  Version: ${IMAGE_TAG}"
    echo "  URL: https://{{AG_HOST}}"

# Ship only the speech worker image to production
ship-speech:
    #!/usr/bin/env bash
    set -euo pipefail

    VERSION=$(git rev-parse --short HEAD)
    TIMESTAMP=$(date +%Y%m%d-%H%M%S)
    IMAGE_TAG="${VERSION}-${TIMESTAMP}"
    SPEECH_IMAGE="${AG_SPEECH_WORKER_IMAGE:-agentcy/speech-worker:latest}"
    REMOTE_TMP="/home/{{AG_USER}}/.agentcy-speech-deploy-${IMAGE_TAG}"

    echo "Shipping speech worker to {{AG_HOST}}"
    echo "  Version: ${IMAGE_TAG}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Pre-flight checks (local only — no SSH yet)
    echo ""
    echo "Pre-flight checks..."
    command -v docker >/dev/null || { echo "Docker not installed locally"; exit 1; }
    [ -d "speech-worker" ] || { echo "speech-worker directory not found"; exit 1; }
    echo "Pre-flight checks passed"

    # Step 1: Build speech worker Docker image
    echo ""
    echo "Building speech worker Docker image..."
    just build-speech-worker

    # Step 2: Save speech worker image to tarball
    echo ""
    echo "Saving speech worker Docker image..."
    mkdir -p releases
    docker save "$SPEECH_IMAGE" | gzip > releases/agentcy-speech-worker.tar.gz
    echo "  Size: $(du -h releases/agentcy-speech-worker.tar.gz | cut -f1)"

    # Open SSH control socket (one TCP connection for all remote operations)
    SSH_SOCK="/tmp/agentcy-speech-deploy-$$"
    SSH_OPTS=(-o ControlMaster=auto -o "ControlPath=${SSH_SOCK}" -o ControlPersist=300 -o ConnectTimeout=30 -o ServerAliveInterval=15)
    trap 'ssh "${SSH_OPTS[@]}" -O exit {{AG_USER}}@{{AG_HOST}} 2>/dev/null || true; rm -f "${SSH_SOCK}"' EXIT

    echo ""
    echo "Connecting to {{AG_HOST}}..."
    CONNECTED=false
    for attempt in 1 2 3; do
        if ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "echo ok" >/dev/null 2>&1; then
            CONNECTED=true
            break
        fi
        echo "  Connection attempt $attempt/3 failed, retrying..."
        sleep 2
    done
    if [ "$CONNECTED" != "true" ]; then
        echo "Cannot reach {{AG_HOST}} via SSH. Check server status."
        exit 1
    fi
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "sudo -n true" >/dev/null 2>&1 || { echo "Deploy user {{AG_USER}} is missing passwordless sudo"; exit 1; }
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "sudo -n test -f {{AG_PATH}}/.env" || { echo "Server .env not found. Run: just setup-server"; exit 1; }

    # Step 3: Upload speech image tarball to server
    echo ""
    echo "Uploading to {{AG_HOST}}..."
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "rm -rf ${REMOTE_TMP} && mkdir -p ${REMOTE_TMP}"
    scp "${SSH_OPTS[@]}" releases/agentcy-speech-worker.tar.gz {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/agentcy-speech-worker.tar.gz

    # Step 4: Load speech image and restart agentcy so it reconciles the worker
    echo ""
    echo "Loading speech image and restarting agentcy..."
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "
        set -euo pipefail

        echo 'Loading Docker image...'
        sudo -n docker load < ${REMOTE_TMP}/agentcy-speech-worker.tar.gz
        rm -rf ${REMOTE_TMP}

        sudo -n systemctl restart agentcy

        echo ''
        echo 'Service status:'
        sudo -n systemctl status agentcy --no-pager -l || true
    "

    # Step 5: Health checks
    echo ""
    echo "Verifying service health..."
    sleep 3

    HEALTH_OK=false
    for i in {1..20}; do
        if ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "curl -sf http://localhost:8081/api/health >/dev/null 2>&1"; then
            HEALTH_OK=true
            break
        fi
        echo "  Waiting for agentcy... ($i/20)"
        sleep 2
    done

    if [ "$HEALTH_OK" != "true" ]; then
        echo "Health check timed out — check logs: just logs-prod"
        exit 1
    fi

    SPEECH_ENABLED=$(ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "sudo -n grep -E '^AG_SPEECH_ENABLED=' {{AG_PATH}}/.env | tail -n1 | cut -d= -f2 | tr -d '\r'" || true)
    if [ "${SPEECH_ENABLED}" = "true" ]; then
        echo "Verifying speech health..."
        SPEECH_OK=false
        for i in {1..20}; do
            if ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "curl -sf http://localhost:8081/api/speech/health | grep -Eq '\"ready\"[[:space:]]*:[[:space:]]*true'" >/dev/null 2>&1; then
                SPEECH_OK=true
                break
            fi
            echo "  Waiting for speech worker... ($i/20)"
            sleep 2
        done

        if [ "$SPEECH_OK" = "true" ]; then
            echo "Speech health check passed"
        else
            echo "Speech health check timed out — check logs: just logs-prod"
            exit 1
        fi
    else
        echo "Speech is disabled on the server; skipped speech health check"
    fi

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Speech deployment complete!"
    echo "  Version: ${IMAGE_TAG}"
    echo "  Host: {{AG_HOST}}"

# SSH into production server
ssh-prod:
    ssh {{AG_USER}}@{{AG_HOST}}

# View production logs
logs-prod:
    ssh {{AG_USER}}@{{AG_HOST}} "sudo -n journalctl -u agentcy -f --no-pager"

# Check production status
status-prod:
    ssh {{AG_USER}}@{{AG_HOST}} "sudo -n systemctl status agentcy --no-pager -l && echo '' && sudo -n docker ps"
