# =============================================================================
# Deployment (agentcy.t1a.dev)
# =============================================================================

AG_HOST := "agentcy.t1a.dev"
AG_BOOTSTRAP_USER := "root"
AG_USER := "agentdeploy"
AG_PATH := "/opt/agentcy"
AG_RUNTIME_USER := "agentcy"

# Initial server setup (run once before first ship)
setup-server:
    #!/usr/bin/env bash
    set -euo pipefail

    echo "Setting up Agentcy server at {{AG_HOST}}"
    echo "=============================================="

    ssh -o ConnectTimeout=10 {{AG_BOOTSTRAP_USER}}@{{AG_HOST}} '
        set -euo pipefail

        # Install Caddy
        if ! command -v caddy &>/dev/null; then
            echo "Installing Caddy..."
            apt-get install -y debian-keyring debian-archive-keyring apt-transport-https
            curl -1sLf "https://dl.cloudsmith.io/public/caddy/stable/gpg.key" | gpg --dearmor -o /usr/share/keyrings/caddy-stable-archive-keyring.gpg
            curl -1sLf "https://dl.cloudsmith.io/public/caddy/stable/debian.deb.txt" | tee /etc/apt/sources.list.d/caddy-stable.list
            apt-get update
            apt-get install -y caddy
            echo "Caddy installed"
        else
            echo "Caddy already installed"
        fi

        # Create directory structure
        echo "Creating directories..."
        mkdir -p {{AG_PATH}}/{bin,data,public}

        # Create dedicated deploy user
        if ! id -u {{AG_USER}} >/dev/null 2>&1; then
            echo "Creating deploy user {{AG_USER}}..."
            useradd --create-home --shell /bin/bash {{AG_USER}}
        else
            echo "Deploy user {{AG_USER}} already exists"
        fi

        # Create dedicated runtime user
        if ! id -u {{AG_RUNTIME_USER}} >/dev/null 2>&1; then
            echo "Creating runtime user {{AG_RUNTIME_USER}}..."
            useradd --system --home-dir {{AG_PATH}} --shell /usr/sbin/nologin {{AG_RUNTIME_USER}}
        else
            echo "Runtime user {{AG_RUNTIME_USER}} already exists"
        fi

        install -d -m 0700 -o {{AG_USER}} -g {{AG_USER}} /home/{{AG_USER}}/.ssh
        if [ -f /root/.ssh/authorized_keys ]; then
            install -m 0600 -o {{AG_USER}} -g {{AG_USER}} /root/.ssh/authorized_keys /home/{{AG_USER}}/.ssh/authorized_keys
        fi

        printf '%s\n' '{{AG_USER}} ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/{{AG_USER}}
        chmod 0440 /etc/sudoers.d/{{AG_USER}}

        chown root:root {{AG_PATH}}
        chmod 0755 {{AG_PATH}}
        chown -R {{AG_RUNTIME_USER}}:{{AG_RUNTIME_USER}} {{AG_PATH}}/data
        chmod 0750 {{AG_PATH}}/data
        chmod 0755 {{AG_PATH}}/bin {{AG_PATH}}/public

        echo ""
        echo "Server setup complete!"
    '

    # Generate .env if it does not exist
    if ssh -o ConnectTimeout=10 {{AG_BOOTSTRAP_USER}}@{{AG_HOST}} "test -f {{AG_PATH}}/.env"; then
        echo ".env already exists on server"
    else
        echo "Creating .env from template..."
        ENCRYPTION_KEY=$(openssl rand -base64 32)
        METRICS_TOKEN=$(openssl rand -hex 32)
        sed \
            -e "s|^AG_SECRET_ENCRYPTION_KEY=.*|AG_SECRET_ENCRYPTION_KEY=${ENCRYPTION_KEY}|" \
            -e "s|^AG_METRICS_BEARER_TOKEN=.*|AG_METRICS_BEARER_TOKEN=${METRICS_TOKEN}|" \
            deploy/agentcy.env.example | \
            ssh -o ConnectTimeout=10 {{AG_BOOTSTRAP_USER}}@{{AG_HOST}} "cat > {{AG_PATH}}/.env && chown root:{{AG_RUNTIME_USER}} {{AG_PATH}}/.env && chmod 0640 {{AG_PATH}}/.env"
        echo ".env created (admin credentials NOT set — edit before first start)"
        echo "  ssh {{AG_USER}}@{{AG_HOST}} 'sudo -n vi {{AG_PATH}}/.env'"
    fi

# Ship to production (build + deploy)
ship:
    #!/usr/bin/env bash
    set -euo pipefail

    VERSION="${AG_RELEASE_VERSION:-$(awk '/^## \[v[0-9]+\.[0-9]+\.[0-9]+([-+][^]]+)?\]/{gsub(/^## \[|\].*/, ""); print; exit}' CHANGELOG.md)}"
    if [[ -z "$VERSION" ]]; then
        echo "Could not determine release version from CHANGELOG.md; set AG_RELEASE_VERSION=vX.Y.Z" >&2
        exit 1
    fi
    if [[ ! "$VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.-]+)?$ ]]; then
        echo "Release version must be semver-like (for example v0.17.0): ${VERSION}" >&2
        exit 1
    fi
    RELEASE_TAG="${VERSION}"
    REMOTE_TMP="/home/{{AG_USER}}/.agentcy-deploy-${RELEASE_TAG}"

    echo "Shipping Agentcy to {{AG_HOST}}"
    echo "  Version: ${RELEASE_TAG}"
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

    # Pre-flight checks (local only — no SSH yet)
    echo ""
    echo "Pre-flight checks..."
    [ -f "deploy/Caddyfile" ] || { echo "deploy/Caddyfile not found"; exit 1; }
    [ -f "deploy/agentcy.service" ] || { echo "deploy/agentcy.service not found"; exit 1; }
    [ -f "deploy/agentcy-backup.service" ] || { echo "deploy/agentcy-backup.service not found"; exit 1; }
    [ -f "deploy/agentcy-backup.timer" ] || { echo "deploy/agentcy-backup.timer not found"; exit 1; }
    [ -x "scripts/backup/pg-dump.sh" ] || { echo "scripts/backup/pg-dump.sh is not executable"; exit 1; }
    [ -x "scripts/backup/restore-drill.sh" ] || { echo "scripts/backup/restore-drill.sh is not executable"; exit 1; }
    just preship
    echo "Pre-flight checks passed"

    # Step 1: Build frontend
    echo ""
    echo "Building frontend..."
    cd frontend && npm run build && cd ..

    # Step 2: Cross-compile Go binary for linux/amd64
    echo ""
    echo "Building Go binary (linux/amd64)..."
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -o bin/agentcy-linux-amd64 ./cmd/agentcy

    # Step 3: Build Firecracker microVM artifacts
    echo ""
    echo "Building Firecracker microVM artifacts..."
    just build-microvm-images

    # Step 4: Package microVM artifacts
    echo ""
    echo "Packaging Firecracker microVM artifacts..."
    mkdir -p releases
    MICROVM_ARTIFACT_DIR="$(readlink -f releases/microvm/latest)"
    [ -f "${MICROVM_ARTIFACT_DIR}/kernel" ] || { echo "Missing ${MICROVM_ARTIFACT_DIR}/kernel"; exit 1; }
    [ -f "${MICROVM_ARTIFACT_DIR}/rootfs.ext4" ] || { echo "Missing ${MICROVM_ARTIFACT_DIR}/rootfs.ext4"; exit 1; }
    [ -f "${MICROVM_ARTIFACT_DIR}/shared.img" ] || { echo "Missing ${MICROVM_ARTIFACT_DIR}/shared.img"; exit 1; }
    tar -C "${MICROVM_ARTIFACT_DIR}" -czf releases/agentcy-microvm-artifacts.tar.gz .
    echo "  Artifact dir: ${MICROVM_ARTIFACT_DIR}"
    echo "  Size: $(du -h releases/agentcy-microvm-artifacts.tar.gz | cut -f1)"

    # Open SSH control socket (one TCP connection for all remote operations)
    SSH_SOCK="/tmp/agentcy-deploy-$$"
    SSH_OPTS=(-o ControlMaster=auto -o "ControlPath=${SSH_SOCK}" -o ControlPersist=300 -o ConnectTimeout=30 -o ServerAliveInterval=15)
    trap 'ssh "${SSH_OPTS[@]}" -O exit {{AG_USER}}@{{AG_HOST}} 2>/dev/null || true; rm -f "${SSH_SOCK}"' EXIT

    echo ""
    echo "Connecting to {{AG_HOST}}..."
    CONNECTED=false
    for attempt in 1 2 3; do
        if ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "echo ok" >/dev/null 2>&1; then
            CONNECTED=true
            break
        fi
        echo "  Connection attempt $attempt/3 failed, retrying..."
        sleep 2
    done
    if [ "$CONNECTED" != "true" ]; then
        echo "Cannot reach {{AG_HOST}} via SSH. Check server status."
        exit 1
    fi
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "sudo -n true" >/dev/null 2>&1 || { echo "Deploy user {{AG_USER}} is missing passwordless sudo"; exit 1; }
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "sudo -n test -f {{AG_PATH}}/.env" || { echo "Server .env not found. Run: just setup-server"; exit 1; }

    # Step 5: Stop service before uploading (can't overwrite a running binary)
    echo "Stopping agentcy service..."
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "sudo -n systemctl stop agentcy 2>/dev/null || true"

    # Step 6: Upload to server (all over the same TCP connection)
    echo ""
    echo "Uploading to {{AG_HOST}}..."
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "rm -rf ${REMOTE_TMP} && mkdir -p ${REMOTE_TMP}"
    scp "${SSH_OPTS[@]}" bin/agentcy-linux-amd64 {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/agentcy
    scp "${SSH_OPTS[@]}" -r cmd/agentcy/public {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/public
    scp "${SSH_OPTS[@]}" releases/agentcy-microvm-artifacts.tar.gz {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/agentcy-microvm-artifacts.tar.gz
    scp "${SSH_OPTS[@]}" deploy/Caddyfile {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/Caddyfile
    scp "${SSH_OPTS[@]}" deploy/agentcy.service {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/agentcy.service
    scp "${SSH_OPTS[@]}" deploy/agentcy-backup.service {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/agentcy-backup.service
    scp "${SSH_OPTS[@]}" deploy/agentcy-backup.timer {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/agentcy-backup.timer
    scp "${SSH_OPTS[@]}" -r scripts/backup {{AG_USER}}@{{AG_HOST}}:${REMOTE_TMP}/backup-scripts

    # Step 7: Install microVM artifacts and restart services
    echo ""
    echo "Installing Firecracker microVM artifacts and restarting services..."
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "
        set -euo pipefail

        if ! id -u {{AG_RUNTIME_USER}} >/dev/null 2>&1; then
            sudo -n useradd --system --home-dir {{AG_PATH}} --shell /usr/sbin/nologin {{AG_RUNTIME_USER}}
        fi
        sudo -n install -d -m 0755 {{AG_PATH}}/bin
        sudo -n install -m 0755 ${REMOTE_TMP}/agentcy {{AG_PATH}}/bin/agentcy

        sudo -n rm -rf {{AG_PATH}}/public
        sudo -n mkdir -p {{AG_PATH}}/public
        sudo -n cp -a ${REMOTE_TMP}/public/. {{AG_PATH}}/public/
        sudo -n chmod 0755 {{AG_PATH}}/public

        sudo -n install -m 0644 ${REMOTE_TMP}/Caddyfile /etc/caddy/Caddyfile
        sudo -n install -m 0644 ${REMOTE_TMP}/agentcy.service /etc/systemd/system/agentcy.service
        sudo -n install -m 0644 ${REMOTE_TMP}/agentcy-backup.service /etc/systemd/system/agentcy-backup.service
        sudo -n install -m 0644 ${REMOTE_TMP}/agentcy-backup.timer /etc/systemd/system/agentcy-backup.timer

        sudo -n rm -rf {{AG_PATH}}/scripts/backup
        sudo -n install -d -m 0755 {{AG_PATH}}/scripts/backup
        sudo -n install -m 0755 ${REMOTE_TMP}/backup-scripts/pg-dump.sh {{AG_PATH}}/scripts/backup/pg-dump.sh
        sudo -n install -m 0755 ${REMOTE_TMP}/backup-scripts/restore-drill.sh {{AG_PATH}}/scripts/backup/restore-drill.sh

        sudo -n chown -R {{AG_RUNTIME_USER}}:{{AG_RUNTIME_USER}} {{AG_PATH}}/data
        sudo -n chmod 0750 {{AG_PATH}}/data
        sudo -n chown root:{{AG_RUNTIME_USER}} {{AG_PATH}}/.env
        sudo -n chmod 0640 {{AG_PATH}}/.env

        echo 'Installing Firecracker microVM artifacts...'
        sudo -n install -d -m 0755 {{AG_PATH}}/microvm
        sudo -n rm -rf {{AG_PATH}}/microvm/${RELEASE_TAG}
        sudo -n install -d -m 0755 {{AG_PATH}}/microvm/${RELEASE_TAG}
        sudo -n tar -xzf ${REMOTE_TMP}/agentcy-microvm-artifacts.tar.gz -C {{AG_PATH}}/microvm/${RELEASE_TAG}
        sudo -n chown -R root:{{AG_RUNTIME_USER}} {{AG_PATH}}/microvm/${RELEASE_TAG}
        sudo -n find {{AG_PATH}}/microvm/${RELEASE_TAG} -type d -exec chmod 0755 {} +
        sudo -n find {{AG_PATH}}/microvm/${RELEASE_TAG} -type f -exec chmod 0644 {} +
        sudo -n ln -sfn {{AG_PATH}}/microvm/${RELEASE_TAG} {{AG_PATH}}/microvm/latest
        sudo -n chown -h root:{{AG_RUNTIME_USER}} {{AG_PATH}}/microvm/latest

        set_env() {
            key=\"\$1\"
            value=\"\$2\"
            if sudo -n grep -q \"^\${key}=\" {{AG_PATH}}/.env; then
                sudo -n sed -i \"s|^\${key}=.*|\${key}=\${value}|\" {{AG_PATH}}/.env
            else
                printf '%s=%s\n' \"\$key\" \"\$value\" | sudo -n tee -a {{AG_PATH}}/.env >/dev/null
            fi
        }
        set_env AG_MICROVM_KERNEL_PATH {{AG_PATH}}/microvm/latest/kernel
        set_env AG_MICROVM_ROOTFS_PATH {{AG_PATH}}/microvm/latest/rootfs.ext4
        set_env AG_MICROVM_SHARED_IMAGE_PATH {{AG_PATH}}/microvm/latest/shared.img
        if ! sudo -n grep -Eq '^AG_METRICS_BEARER_TOKEN=.+$' {{AG_PATH}}/.env; then
            set_env AG_METRICS_BEARER_TOKEN "\$(openssl rand -hex 32)"
            echo 'Generated AG_METRICS_BEARER_TOKEN in {{AG_PATH}}/.env'
        fi

        rm -rf ${REMOTE_TMP}

        sudo -n systemctl daemon-reload
        sudo -n systemctl enable agentcy
        sudo -n systemctl restart agentcy

        sudo -n systemctl reload caddy || sudo -n systemctl restart caddy

        echo ''
        echo 'Service status:'
        sudo -n systemctl status agentcy --no-pager -l || true
    "

    # Step 8: Health check
    echo ""
    echo "Verifying service health..."
    sleep 3

    HEALTH_OK=false
    for i in {1..20}; do
        if ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "curl -sf http://localhost:8081/api/health >/dev/null 2>&1"; then
            HEALTH_OK=true
            break
        fi
        echo "  Waiting for services... ($i/20)"
        sleep 2
    done

    if [ "$HEALTH_OK" = "true" ]; then
        echo "Health check passed"
    else
        echo "Health check timed out — check logs: just logs-prod"
    fi

    # Record deployed version
    ssh "${SSH_OPTS[@]}" {{AG_USER}}@{{AG_HOST}} "printf '%s\n' '${RELEASE_TAG}' | sudo -n tee {{AG_PATH}}/.deployed_version >/dev/null"

    echo ""
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
    echo "Deployment complete!"
    echo "  Version: ${RELEASE_TAG}"
    echo "  URL: https://{{AG_HOST}}"

# SSH into production server
ssh-prod:
    ssh {{AG_USER}}@{{AG_HOST}}

# View production logs
logs-prod:
    ssh {{AG_USER}}@{{AG_HOST}} "sudo -n journalctl -u agentcy -f --no-pager"

# Check production status
status-prod:
    ssh {{AG_USER}}@{{AG_HOST}} "sudo -n systemctl status agentcy --no-pager -l"
