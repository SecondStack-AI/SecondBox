# Build signed Firecracker kernel/rootfs/shared-image artifacts for agent runtimes.
build-microvm-images:
    scripts/microvm-image/build.sh

# Build signed images from a reproducible standard rootfs source
# (scripts/microvm-image/rootfs/). Prepares the source dir via debootstrap+docker,
# then builds and signs, reusing the current kernel. Needs Docker and network
# egress; a digest-pinned container supplies debootstrap when host root is absent.
build-microvm-images-std:
    #!/usr/bin/env bash
    set -euo pipefail
    scripts/microvm-image/rootfs/build-rootfs-source.sh
    AGENT_MANAGER_MICROVM_ROOTFS_SOURCE_DIR="${AGENT_MANAGER_MICROVM_ROOTFS_SOURCE_DIR:-tmp/microvm-rootfs-src}" \
    AGENT_MANAGER_MICROVM_KERNEL_PATH="${AGENT_MANAGER_MICROVM_KERNEL_PATH:-releases/microvm/latest/kernel}" \
    AGENT_MANAGER_MICROVM_ROOTFS_SIZE_MIB="${AGENT_MANAGER_MICROVM_ROOTFS_SIZE_MIB:-10240}" \
    scripts/microvm-image/build.sh

# Build the deployable agent runtime artifacts.
build-runtime: build-microvm-images

# Build only the pinned Firecracker guest kernel from scripts/microvm-image/kernel.lock.
build-microvm-kernel:
    scripts/microvm-image/build-kernel.sh "${AGENT_MANAGER_MICROVM_KERNEL_OUT_DIR:-tmp/microvm-kernel}"

# Verify signed Firecracker artifacts. Override AGENT_MANAGER_MICROVM_OUT_DIR to select a build.
verify-microvm-images:
    scripts/microvm-image/verify.sh "${AGENT_MANAGER_MICROVM_OUT_DIR:-releases/microvm/latest}" "${AGENT_MANAGER_MICROVM_PUBLIC_KEY:-}"

# Validate Firecracker staging host prerequisites. Pass --static via ARGS for
# non-root config/artifact checks only.
verify-microvm-staging *ARGS:
    scripts/microvm-stage-check.sh {{ARGS}}

# Use `just build-runtime` when a prepared AGENT_MANAGER_MICROVM_ROOTFS_SOURCE_DIR is available for signed Firecracker images.
# Build all self-contained code artifacts
