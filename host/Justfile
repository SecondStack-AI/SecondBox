# Image paths may name releases/microvm/latest/*; manager startup pins the concrete target.
# Rebuild Firecracker runtime artifacts and restart running agents.
rollout-microvm-images api_url="http://localhost:8081":
    #!/usr/bin/env bash
    set -euo pipefail

    just build-microvm-images

    TOKEN="${AGENTCY_API_TOKEN:-${AG_API_AUTH_TOKEN:-}}"
    HEADERS=(-H "Content-Type: application/json")
    if [ -n "$TOKEN" ]; then
        HEADERS+=(-H "X-Agentcy-Token: $TOKEN")
    fi

    curl -fsS -X POST "{{api_url}}/api/admin/restart-running-agents" "${HEADERS[@]}"

