[Unit]
Description=SecondStack Sandbox Host
After=local-fs.target network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/sandbox-host
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/run/sandbox-host/host.env
Restart=on-failure
RestartSec=2s
KillMode=mixed
TimeoutStopSec=45s
UMask=0077

[Install]
WantedBy=multi-user.target
