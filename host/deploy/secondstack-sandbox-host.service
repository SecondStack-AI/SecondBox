[Unit]
Description=SecondStack Agent Manager Sandbox Host launcher
After=local-fs.target network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/agent-manager-vmlauncher
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=/run/agent-sandbox-host/launcher.env
Restart=on-failure
RestartSec=2s
KillMode=mixed
TimeoutStopSec=45s
UMask=0077

[Install]
WantedBy=multi-user.target
