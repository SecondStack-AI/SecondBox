#!/bin/sh
set -eu

mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys || mount -t sysfs sysfs /sys
mountpoint -q /dev || mount -t devtmpfs devtmpfs /dev
# The tool guest never needs raw memory, KVM, or TUN device access. devtmpfs
# creates some of these nodes from the guest kernel's built-in device set even
# though Firecracker did not pass the corresponding host devices through.
# Remove them before accepting any vsock tool request so the guest boundary is
# explicit and remains testable from inside the VM.
rm -f /dev/mem /dev/kmem /dev/port /dev/kvm /dev/net/tun
mkdir -p /dev/shm
mountpoint -q /dev/shm || mount -t tmpfs -o rw,nosuid,nodev,mode=1777,size=512m tmpfs /dev/shm

process_limit="$(sed -n 's/.*agent-manager\.process_limit=\([0-9][0-9]*\).*/\1/p' /proc/cmdline)"
if [ -n "$process_limit" ]; then
    mkdir -p /sys/fs/cgroup
    mountpoint -q /sys/fs/cgroup || mount -t cgroup2 cgroup2 /sys/fs/cgroup
    grep -qw pids /sys/fs/cgroup/cgroup.controllers
    grep -qw pids /sys/fs/cgroup/cgroup.subtree_control || printf '%s\n' +pids > /sys/fs/cgroup/cgroup.subtree_control
    mkdir -p /sys/fs/cgroup/agent-manager-tools
    printf '%s\n' "$process_limit" > /sys/fs/cgroup/agent-manager-tools/pids.max
    printf '%s\n' "$$" > /sys/fs/cgroup/agent-manager-tools/cgroup.procs
fi

mkdir -p /workspace /runtime-private
# runtime-private holds vsock-delivered secrets; keep it RAM-only so credentials
# never land on the persistent workspace image or any snapshot.
mountpoint -q /runtime-private || mount -t tmpfs -o rw,nosuid,nodev,mode=0700 tmpfs /runtime-private
if ! mountpoint -q /workspace; then
    workspace_mode=rw
    if [ "$(cat /sys/block/vdb/ro)" = "1" ]; then
        workspace_mode=ro
    fi
    mount -t ext4 -o "$workspace_mode",noatime /dev/vdb /workspace
fi

if [ -b /dev/vdc ]; then
    mkdir -p /shared
    mount -o ro /dev/vdc /shared
fi

exec /usr/local/bin/sandbox-tool-entrypoint \
    --agents=/workspace/config/agents.md \
    --soul=/workspace/config/soul.md \
    --tools=/workspace/config/tools.md \
    /workspace
