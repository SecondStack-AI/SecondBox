{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondbox.dev/contracts/release/v1/common.schema.json",
  "$defs": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "tag", "sourceCommit"],
      "properties": {
        "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
        "tag": {"type": "string", "pattern": "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"},
        "sourceCommit": {"type": "string", "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "digest"],
      "properties": {
        "location": {"type": "string", "format": "uri", "pattern": "^https://"},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "protocolWindow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 1},
        "maximum": {"type": "integer", "minimum": 1}
      }
    },
    "platform": {"type": "string", "pattern": "^[a-z0-9]+/[a-z0-9][a-z0-9._-]*$"}
  }
}
