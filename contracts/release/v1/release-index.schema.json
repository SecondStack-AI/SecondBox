{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondbox.dev/contracts/release/v1/release-index.schema.json",
  "title": "SecondBox final coordinated release index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "tag", "sourceCommit", "artifactManifest", "qualificationAttestation"],
  "properties": {
    "schemaVersion": {"const": "secondbox.release/release-index/v1"},
    "version": {"$ref": "common.schema.json#/$defs/identity/properties/version"},
    "tag": {"$ref": "common.schema.json#/$defs/identity/properties/tag"},
    "sourceCommit": {"$ref": "common.schema.json#/$defs/identity/properties/sourceCommit"},
    "artifactManifest": {"$ref": "common.schema.json#/$defs/reference"},
    "qualificationAttestation": {"$ref": "common.schema.json#/$defs/reference"}
  }
}
