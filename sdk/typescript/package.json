{
  "name": "@secondstack-ai/secondbox",
  "version": "0.0.0-development",
  "description": "Thin SecondBox transport with lifecycle, execution, filesystem, terminal, and Flue helpers.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SecondStack-AI/SecondBox.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/SecondStack-AI/SecondBox",
  "bugs": {
    "url": "https://github.com/SecondStack-AI/SecondBox/issues"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./flue": {
      "types": "./dist/flue.d.ts",
      "import": "./dist/flue.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    }
  },
  "dependencies": {
    "ws": "^8.21.2"
  },
  "peerDependencies": {
    "@flue/runtime": "^2.0.0"
  },
  "scripts": {
    "build": "node ./prepare-package.mjs",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
